apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ jenkins_name }}
  namespace: {{ jenkins_namespace }}
  labels:
    app: {{ jenkins_label }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ jenkins_label }}
  template:
    metadata:
      labels:
        app: {{ jenkins_label }}
    spec:
      containers:
        - name: {{ jenkins_name }}
          image: {{ jenkins_image }}
          ports:
            - containerPort: 8080
            - containerPort: 50000
      volumeMounts:
        - name: jenkins-data
          mountPath: /var/jenkins_home
      volumes:
        - name: jenkins-data
          emptyDir: {}